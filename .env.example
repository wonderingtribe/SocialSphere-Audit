# ---------------------------------------------------------------------------
# SocialSphere AI — environment configuration
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit real values.
#
# The API server runs without a database or Stripe credentials: it serves the
# labeled DEMO dataset and reports billing as unconfigured. Every feature works
# honestly; nothing pretends to connect to a platform or process a payment.

# ---- Database (PostgreSQL) ---------------------------------------------------
# Required for real persistence. Drizzle pools this connection string.
# On Replit, this is provisioned automatically. Locally:
#   postgresql://postgres@localhost:5432/socialsphere
DATABASE_URL=

# ---- API server --------------------------------------------------------------
# Port the Express server listens on (development default 5000).
PORT=5000

# Public base URL of the deployed API. Used to build OAuth callbacks and
# webhook callback URLs. Example: https://api.example.com
PUBLIC_BASE_URL=

# ---- Stripe billing ----------------------------------------------------------
# Sk: test mode secret key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret from stripe listen / dashboard webhooks.
STRIPE_WEBHOOK_SECRET=

# ---- Platform OAuth (Connect tab / integrations) -----------------------------
# Each platform needs real OAuth app credentials from its developer console.
# Until set, the Connect tab reports the platform as "not configured" (honest).
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# ---- Webhooks ----------------------------------------------------------------
# Fixed verify token for all platforms (optional; otherwise one is generated
# and stored per platform). Paste whatever you set here into the platform's
# developer dashboard alongside the callback URL.
WEBHOOK_VERIFY_TOKEN=
# Comma-separated list of platforms that require a webhook registration
# (defaults to instagram,facebook,linkedin if unset).
WEBHOOK_PLATFORMS=

# ---- Mobile app (set at build time) -----------------------------------------
# Origin of the deployed API the phone build should talk to. When unset, the
# app falls back to offline demo data. Example: https://api.example.com
EXPO_PUBLIC_API_URL=